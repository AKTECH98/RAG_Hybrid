# ---------------------------------------------------------------- OpenAI (default)
OPENAI_API_KEY=sk-...

# ---------------------------------------------------------------- Local / Ollama
# Run everything without OpenAI: LLM on an Ollama server, embeddings on this machine.
# DOCRAG_LLM_PROVIDER=ollama
# DOCRAG_OLLAMA_BASE_URL=http://localhost:11434
# DOCRAG_OLLAMA_NUM_CTX=8192          # per-request context; Ollama's default (2048) truncates
# DOCRAG_GENERATION_MODEL=qwen3:4b-instruct-2507-q4_K_M
# DOCRAG_JUDGE_MODEL=qwen3:4b-instruct-2507-q4_K_M
# DOCRAG_EVAL_JUDGE_MODEL=qwen3:4b-instruct-2507-q4_K_M
# DOCRAG_RERANKER=cross_encoder       # local model; keeps reranking off the LLM server
#
# Embeddings: openai | local (sentence-transformers) | ollama. Each has its own index:
#   uv run python scripts/seed.py --embedder local
# DOCRAG_EMBEDDING_PROVIDER=ollama    # nomic-embed-text (recommended with the Ollama LLM:
#                                     # best answerable/unanswerable separation in the eval)
# DOCRAG_EMBEDDING_PROVIDER=local     # BAAI/bge-base-en-v1.5 on this machine

# ---------------------------------------------------------------- Tuning (any Settings field)
# DOCRAG_DENSE_WEIGHT=0.7
# DOCRAG_SPARSE_WEIGHT=0.3
